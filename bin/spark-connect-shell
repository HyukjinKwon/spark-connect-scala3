# A Spark-Connect REPL, in the spirit of Spark's ./bin/spark-shell. It opens a
# Scala 3 REPL with this client on the classpath and a `spark` session already
# connected to the given Spark Connect server.
#
# Usage:
#   bin/spark-connect-shell [--remote sc://host:port] [sc://host:port]
#
# The address is taken from --remote, then a positional sc:// argument, then the
# SPARK_REMOTE environment variable, and finally defaults to sc://localhost:15002.

set -euo pipefail

remote="${SPARK_REMOTE:-sc://localhost:15002}"

while [ $# -gt 0 ]; do
  case "$1" in
    -r|--remote)
      [ $# -ge 2 ] || { echo "error: $1 needs an address" >&2; exit 2; }
      remote="$2"; shift 2 ;;
    sc://*)
      remote="$1"; shift ;;
    -h|--help)
      sed -n '18,28p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)
      echo "error: unknown argument '$1' (try --help)" >&2; exit 2 ;;
  esac
done

if ! command -v sbt >/dev/null 2>&1; then
  echo "error: 'sbt' is required on PATH to run this shell." >&2
  echo "Install it from https://www.scala-sbt.org or use the scala-cli recipe in docs/installation.md." >&2
  exit 1
fi

# Run from the repository root so sbt picks up this build.
cd "$(cd "$(dirname "$0")/.." && pwd)"

echo "Starting Spark Connect shell against ${remote} (first run compiles the client) ..."

# -J flags open the JDK modules Apache Arrow needs on JDK 17+; the -D property is
# read by the client/console initialCommands to build the `spark` session.
exec sbt \
  -J--add-opens=java.base/java.nio=ALL-UNNAMED \
  -J--add-opens=java.base/sun.nio.ch=ALL-UNNAMED \
  -Dspark.connect.shell.remote="${remote}" \
  client/console
